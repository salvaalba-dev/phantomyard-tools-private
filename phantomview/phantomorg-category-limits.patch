--- /dev/null
+++ b/phantomorg/tests/test_category_limits.py
@@ -0,0 +1,92 @@
+"""Restriction metadata cannot widen the inherited counterpart categories."""
+import copy
+from dataclasses import asdict
+import json
+from pathlib import Path
+
+from jsonschema import Draft7Validator
+import pytest
+import yaml
+
+from phantomorg.spec.model import OrgSpec
+from phantomorg.spec.shape_validator import ShapeError, validate_shape
+from phantomorg.validator.refs import check_references
+
+ROOT = Path(__file__).parent.parent
+SCHEMA = json.loads((ROOT / "phantomorg/spec/schema.json").read_text(encoding="utf-8"))
+
+
+@pytest.fixture
+def org():
+    source = yaml.safe_load((ROOT / "organizations/verdant-aquaponics/org.yaml").read_text(encoding="utf-8"))
+    source["humans"] = [{"id": "member", "counterpart_persona": "lucia"}, {"id": "owner"}, {"id": "unbound"}]
+    source["policies"]["security_categories"]["category-0"]["owner"] = "owner"
+    source["policies"]["security_categories"]["category-4-river"] = {"label": "Project sensitive"}
+    actor = next(row for row in source["actors"] if row["id"] == "lucia")
+    actor.setdefault("actor_exceptions", []).append("category-4-river")
+    source["policies"]["phantomview"] = {"human_category_limits": {"member": ["category-4-river"]}}
+    return source
+
+
+def test_round_trip_preserves_restriction_and_does_not_modify_persona(org):
+    before = copy.deepcopy(org)
+    assert Draft7Validator(SCHEMA).is_valid(org)
+    validate_shape(org)
+    model = OrgSpec.from_dict(org)
+    assert check_references(model) == []
+    assert asdict(model.policies.phantomview)["human_category_limits"] == {"member": ["category-4-river"]}
+    org["policies"]["phantomview"]["human_category_limits"]["member"].append("category-1")
+    assert model.policies.phantomview.human_category_limits == {"member": ["category-4-river"]}
+    assert before["actors"] == org["actors"]
+
+
+@pytest.mark.parametrize("limits", [None, [], {"member": []}, {"member": "category-1"},
+    {"member": [1]}, {"member": ["category-0"]}, {"member": ["category-1", "category-1"]}])
+def test_invalid_shapes_rejected_by_both_validators(org, limits):
+    org["policies"]["phantomview"]["human_category_limits"] = limits
+    assert not Draft7Validator(SCHEMA).is_valid(org)
+    with pytest.raises(ShapeError):
+        validate_shape(org)
+
+
+@pytest.mark.parametrize("human,categories", [("missing", ["category-1"]), ("unbound", ["category-1"]),
+    ("member", ["category-unknown"]), ("owner", ["category-1"])])
+def test_unknown_unbound_and_ungranted_references_rejected(org, human, categories):
+    if human == "owner":
+        org["humans"][0].pop("counterpart_persona")
+        org["humans"][1]["counterpart_persona"] = "lucia"
+    org["policies"]["phantomview"]["human_category_limits"] = {human: categories}
+    validate_shape(org)
+    assert any("human_category_limits" in error for error in check_references(OrgSpec.from_dict(org)))
+
+
+def test_missing_field_preserves_existing_defaults(org):
+    del org["policies"]["phantomview"]["human_category_limits"]
+    validate_shape(org)
+    model = OrgSpec.from_dict(org)
+    assert model.policies.phantomview.human_category_limits == {}
+    assert check_references(model) == []
+
+
+def test_declared_but_ungranted_category_is_not_an_escalation(org):
+    org["policies"]["security_categories"]["category-8-ungranted"] = {"label": "Not granted"}
+    org["policies"]["phantomview"]["human_category_limits"] = {"member": ["category-8-ungranted"]}
+    validate_shape(org)
+    assert any("human_category_limits" in error for error in check_references(OrgSpec.from_dict(org)))
+
+
+def test_role_exceptions_and_level_categories_remain_valid_sources(org):
+    actor = next(row for row in org["actors"] if row["id"] == "lucia")
+    role = next(row for row in org["roles"] if row["id"] == actor["role"])
+    role["security_exceptions"] = ["category-4-river"]
+    actor["actor_exceptions"] = []
+    org["policies"]["access_levels"][role["access_level"]]["categories"] = [1, 2]
+    org["policies"]["phantomview"]["human_category_limits"]["member"] = ["category-1", "category-2", "category-4-river"]
+    validate_shape(org)
+    assert check_references(OrgSpec.from_dict(org)) == []
+
+
+def test_absolute_owner_name_alias_is_still_independent(org):
+    org["humans"][0]["name"] = "Board Owner"
+    org["policies"]["security_categories"]["category-0"]["owner"] = " board owner "
+    assert any("absolute owner" in error for error in check_references(OrgSpec.from_dict(org)))
