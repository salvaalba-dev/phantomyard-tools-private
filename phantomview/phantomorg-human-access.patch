+"""Private scope metadata agrees across schema, shape, model and references."""
+import copy
+import json
+from pathlib import Path
+
+from jsonschema import Draft7Validator
+import pytest
+import yaml
+
+from phantomorg.spec.model import OrgSpec
+from phantomorg.spec.shape_validator import ShapeError, validate_shape
+from phantomorg.validator.refs import check_references
+
+ROOT = Path(__file__).parent.parent
+SCHEMA = json.loads((ROOT / 'phantomorg/spec/schema.json').read_text(encoding='utf-8'))
+
+
+@pytest.fixture
+def org():
+    data = yaml.safe_load((ROOT / 'organizations/verdant-aquaponics/org.yaml').read_text(encoding='utf-8'))
+    data['humans'] = [{'id': 'alice', 'counterpart_persona': 'marco', 'telegram_user_id': 101}]
+    data['policies']['security_categories']['category-0']['owner'] = 'alice'
+    data['policies']['phantomview'] = {
+        'project_grants': {'marco': ['river-project']},
+        'scope_definitions': {
+            data['organization']['id']: {'kind': 'organization', 'label': 'Example Organization'},
+            data['departments'][0]['id']: {'kind': 'department', 'label': 'Example Department'},
+            'river-project': {'kind': 'project', 'label': 'River Project'},
+        },
+        'persona_scope_grants': {'marco': [data['organization']['id'], 'river-project']},
+        'human_action_grants': {'alice': {'view.personal.edit': ['river-project']}},
+    }
+    return data
+
+
+def test_scope_model_preserves_explicit_fields(org):
+    assert Draft7Validator(SCHEMA).is_valid(org)
+    validate_shape(org)
+    model = OrgSpec.from_dict(org)
+    assert check_references(model) == []
+    view = model.policies.phantomview
+    assert view.scope_definitions['river-project'].kind == 'project'
+    assert view.scope_definitions['river-project'].label == 'River Project'
+    assert view.persona_scope_grants['marco'][-1] == 'river-project'
+    assert view.human_action_grants['alice'] == {'view.personal.edit': ['river-project']}
+    assert 'view.shared.edit' not in view.human_action_grants['alice']
+
+
+@pytest.mark.parametrize('field,value', [
+    ('scope_definitions', None), ('scope_definitions', {}),
+    ('scope_definitions', {'river-project': {'kind': 'unknown'}}),
+    ('scope_definitions', {'river-project': {'kind': ['project']}}),
+    ('scope_definitions', {'river-project': {'kind': 'project', 'label': '  '}}),
+    ('scope_definitions', {'river-project': {'kind': 'project', 'unexpected': True}}),
+    ('scope_definitions', {'con': {'kind': 'project'}}),
+    ('persona_scope_grants', {'marco': ['river-project', 'river-project']}),
+    ('persona_scope_grants', {'marco': '../river-project'}),
+    ('human_action_grants', {'alice': {'execute': ['river-project']}}),
+    ('human_action_grants', {'alice': {'view.shared.edit': None}}),
+    ('human_action_grants', {'alice': {'view.shared.edit': ['river-project', 'river-project']}}),
+])
+def test_shape_and_schema_reject_same_invalid_fields(org, field, value):
+    org['policies']['phantomview'][field] = value
+    assert not Draft7Validator(SCHEMA).is_valid(org)
+    with pytest.raises(ShapeError):
+        validate_shape(org)
+
+
+@pytest.mark.parametrize('field', ['persona_scope_grants', 'human_action_grants'])
+def test_grants_require_scope_definitions_even_when_empty(org, field):
+    org['policies']['phantomview'] = {field: {}}
+    assert not Draft7Validator(SCHEMA).is_valid(org)
+    with pytest.raises(ShapeError):
+        validate_shape(org)
+
+
+@pytest.mark.parametrize('mutation,expected', [
+    (lambda view: view['scope_definitions'].update(unknown={'kind': 'department'}), 'department scope'),
+    (lambda view: view['scope_definitions'].update(other={'kind': 'organization'}), 'organization scope'),
+    (lambda view: view['persona_scope_grants'].update(stranger=['river-project']), 'scope actor'),
+    (lambda view: view['persona_scope_grants'].update(marco=['unknown']), 'granted scope'),
+    (lambda view: view['project_grants'].update(marco=[]), 'requires project grant'),
+    (lambda view: view['project_grants'].update(marco=['unknown']), 'requires a project scope'),
+    (lambda view: view['human_action_grants'].update(stranger={'view.shared.edit': ['river-project']}), 'action human'),
+    (lambda view: view['human_action_grants'].update(alice={'view.shared.edit': ['unknown']}), 'action scope'),
+])
+def test_reference_validation_rejects_unknown_or_implicit_grants(org, mutation, expected):
+    mutation(org['policies']['phantomview'])
+    validate_shape(org)
+    assert any(expected in problem for problem in check_references(OrgSpec.from_dict(org)))
+
+
+def test_legacy_project_grants_do_not_require_new_scope_mode(org):
+    original = copy.deepcopy(org)
+    original['policies']['phantomview'] = {'project_grants': {'marco': ['legacy-project']}}
+    validate_shape(original)
+    assert check_references(OrgSpec.from_dict(original)) == []
