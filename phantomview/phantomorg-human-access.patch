+"""Explicit human bindings are source metadata, never channel authentication."""
+
+import copy
+from dataclasses import asdict
+import json
+from pathlib import Path
+
+from jsonschema import Draft7Validator
+import pytest
+import yaml
+
+from phantomorg.compiler.humans import render_humans
+from phantomorg.spec.model import OrgSpec
+from phantomorg.spec.shape_validator import ShapeError, validate_shape
+from phantomorg.validator.refs import check_references
+
+ROOT = Path(__file__).parent.parent
+SCHEMA = json.loads((ROOT / "phantomorg/spec/schema.json").read_text(encoding="utf-8"))
+
+
+@pytest.fixture
+def org():
+    data = yaml.safe_load(
+        (ROOT / "organizations/verdant-aquaponics/org.yaml").read_text(encoding="utf-8")
+    )
+    data["humans"] = [
+        {
+            "id": "alice",
+            "name": "Alice",
+            "counterpart_persona": "marco",
+            "telegram_user_id": 101,
+        },
+        {
+            "id": "blair",
+            "name": "Blair",
+            "counterpart_persona": "lucia",
+            "telegram_user_id": 102,
+        },
+        {
+            "id": "chris",
+            "name": "Chris",
+            "counterpart_persona": "diego",
+            "email": "chris@example.org",
+        },
+    ]
+    data["policies"]["security_categories"]["category-0"]["owner"] = "alice"
+    data["policies"]["phantomview"] = {"project_grants": {"lucia": ["greenroot"]}}
+    return data
+
+
+def assert_shape_agrees(org, accepted):
+    assert Draft7Validator(SCHEMA).is_valid(org) is accepted
+    if accepted:
+        validate_shape(org)
+    else:
+        with pytest.raises(ShapeError):
+            validate_shape(org)
+
+
+def test_valid_matrix_is_preserved_in_typed_model_and_registry(org):
+    assert_shape_agrees(org, True)
+    model = OrgSpec.from_dict(org)
+    assert check_references(model) == []
+    assert model.humans[0].counterpart_persona == "marco"
+    assert model.humans[2].telegram_user_id is None
+    assert model.humans[2].email == "chris@example.org"
+    assert asdict(model.policies.phantomview) == {
+        "project_grants": {"lucia": ["greenroot"]}
+    }
+    assert "counterpart_persona" in render_humans(model)
+    assert "`diego`" in render_humans(model)
+
+
+@pytest.mark.parametrize(
+    "value", [None, True, 4, "", "../marco", "marco\n", "con", "a" * 65]
+)
+def test_counterpart_shape_and_schema_reject_invalid_ids(org, value):
+    org["humans"][0]["counterpart_persona"] = value
+    assert_shape_agrees(org, False)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        None,
+        [],
+        {"unexpected": {}},
+        {"project_grants": []},
+        {"project_grants": {"lucia": "greenroot"}},
+        {"project_grants": {"lucia": ["greenroot", "greenroot"]}},
+        {"project_grants": {"../actor": []}},
+        {"project_grants": {"lucia": ["../project"]}},
+    ],
+)
+def test_policy_shape_and_schema_reject_invalid_project_grants(org, value):
+    org["policies"]["phantomview"] = value
+    assert_shape_agrees(org, False)
+
+
+def test_omitted_fields_are_backward_compatible_and_do_not_change_legacy_registry(org):
+    del org["policies"]["phantomview"]
+    for human in org["humans"]:
+        del human["counterpart_persona"]
+    assert_shape_agrees(org, True)
+    model = OrgSpec.from_dict(org)
+    assert model.policies.phantomview is None
+    assert all(h.counterpart_persona is None for h in model.humans)
+    assert "counterpart_persona" not in render_humans(model)
+    assert check_references(model) == []
+
+
+@pytest.mark.parametrize(
+    "mutation, message",
+    [
+        (
+            lambda o: o["humans"][0].update(counterpart_persona="missing"),
+            "does not exist",
+        ),
+        (
+            lambda o: o["humans"][1].update(counterpart_persona="marco"),
+            "already assigned",
+        ),
+        (
+            lambda o: o["humans"][1].update(telegram_user_id=101),
+            "telegram_user_id duplicated",
+        ),
+        (
+            lambda o: o["policies"]["phantomview"]["project_grants"].update(missing=[]),
+            "actor 'missing'",
+        ),
+        (
+            lambda o: o["policies"]["security_categories"]["category-0"].update(
+                owner="unknown"
+            ),
+            "exactly one",
+        ),
+        (
+            lambda o: o["policies"]["security_categories"]["category-0"].update(
+                owner=""
+            ),
+            "exactly one",
+        ),
+        (lambda o: o["humans"][1].update(name="Alice"), "exactly one"),
+    ],
+)
+def test_reference_validation_rejects_ambiguous_or_missing_principals(
+    org, mutation, message
+):
+    mutation(org)
+    validate_shape(org)
+    assert any(
+        message in problem for problem in check_references(OrgSpec.from_dict(org))
+    )
+
+
+def test_independent_category_zero_owner_need_not_have_a_counterpart(org):
+    del org["humans"][0]["counterpart_persona"]
+    assert check_references(OrgSpec.from_dict(org)) == []
+    org["policies"]["security_categories"]["category-0"].pop("owner")
+    # Runtime default resolution still needs a trusted installation and unique binding.
+    assert check_references(OrgSpec.from_dict(org)) == []
+
+
+def test_explicit_null_category_zero_owner_never_triggers_runtime_fallback(org):
+    org["policies"]["security_categories"]["category-0"]["owner"] = None
+    assert_shape_agrees(org, False)
+    del org["policies"]["phantomview"]
+    assert_shape_agrees(org, True)
+
+
+def test_no_category_zero_declaration_is_rejected_only_for_opt_in_policy(org):
+    org["policies"]["security_categories"].pop("category-0")
+    org["actors"][0]["actor_exceptions"] = []
+    assert any(
+        "category-0 must be declared" in p
+        for p in check_references(OrgSpec.from_dict(org))
+    )
+    org["policies"].pop("phantomview")
+    assert check_references(OrgSpec.from_dict(org)) == []
+
+
+def test_legacy_category_owner_semantics_are_unchanged_without_opt_in(org):
+    org["policies"].pop("phantomview")
+    org["policies"]["security_categories"]["category-0"]["owner"] = "Legacy actor label"
+    before = copy.deepcopy(org)
+    assert check_references(OrgSpec.from_dict(org)) == []
+    assert org == before
+
+
+def test_existing_dashboard_display_name_is_preserved_without_changing_org_identity(
+    org,
+):
+    org["organization"]["display_name"] = "Example NGO"
+    assert_shape_agrees(org, True)
+    model = OrgSpec.from_dict(org)
+    assert model.organization.display_name == "Example NGO"
+    assert model.organization.id == "verdant-aquaponics"
+    for value in (None, "", False):
+        org["organization"]["display_name"] = value
+        assert_shape_agrees(org, False)
